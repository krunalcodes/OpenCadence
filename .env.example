POSTGRES_USER=opencadence
POSTGRES_PASSWORD=opencadence
POSTGRES_DB=opencadence
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=opencadence
MINIO_ROOT_PASSWORD=opencadence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opencadence
S3_ACCESS_KEY_ID=opencadence
S3_SECRET_ACCESS_KEY=opencadence
S3_FORCE_PATH_STYLE=true

DATABASE_URL=postgres://opencadence:opencadence@localhost:5432/opencadence

BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

CREDENTIALS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
CREDENTIALS_ENCRYPTION_KEY_VERSION=1
CREDENTIALS_ENCRYPTION_OLD_KEYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Reply detection for Gmail mailboxes asks Google for read access to the
# mailbox (the gmail.readonly scope). Google only allows that scope on a
# public OAuth client after its security assessment, so it is off by default.
# Set it to true on a self-hosted install whose OAuth client may request it.
# While it is off, the Integrations page recommends an IMAP/SMTP connection
# with an app password for mailboxes that need reply detection.
GMAIL_READ_SCOPE_ENABLED=false

# OAuth client for connecting Outlook and Microsoft 365 mailboxes, from an app
# registration in Microsoft Entra. Register this redirect URL on it:
# BETTER_AUTH_URL plus /api/v1/sending-sources/outlook/callback. Empty leaves
# Outlook mailboxes off. OUTLOOK_TENANT is common, organizations, consumers,
# a tenant ID, or a tenant domain; empty means common.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common

# Reply detection for Outlook mailboxes asks Microsoft for the Mail.Read
# permission when a user turns it on. Set it to false to never request it.
OUTLOOK_READ_SCOPE_ENABLED=true

WEBHOOK_BASE_URL=

# Public address that uploaded images are served from. Mail clients load
# images from it, so a real install sets one they can reach, for example
# https://mail.example.com/api/v1. Empty uses BETTER_AUTH_URL plus /api/v1.
MEDIA_BASE_URL=

# Public address of the open, click, and unsubscribe links placed in emails.
# Mail clients and recipients follow them, so a real install sets one they
# can reach, for example https://mail.example.com/api/v1. Empty uses
# BETTER_AUTH_URL plus /api/v1.
TRACKING_BASE_URL=

# The writing assistant calls the OpenAI-compatible endpoint a workspace
# saves. By default it must be https and must not point to a local or private
# address. Set this to true only to use a model server on your own network,
# for example one running on this machine.
AI_ALLOW_PRIVATE_ENDPOINTS=false

BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

EMAIL_PROVIDER=console
EMAIL_FROM=OpenCadence <no-reply@localhost>
RESEND_API_KEY=

API_URL=http://localhost:3001
